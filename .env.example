# PostgreSQL connection (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/staff_first_booking?schema=public"

# Shopify app (filled by `shopify app dev` / `shopify app config link`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS origin of this app (tunnel URL in dev, production domain live).
SHOPIFY_APP_URL=https://your-app-domain.example.com
# Keep in sync with [access_scopes] in shopify.app.toml.
SCOPES=read_products

# Session secret for cookie signing (32+ random characters)
SESSION_SECRET=replace-with-a-long-random-string

# Public support address shown on /privacy and /terms
SUPPORT_EMAIL=support@your-domain.example.com

# Optional: use Shopify Billing test charges. Defaults to true outside
# production. Set to "true" on the production deployment only while the app is
# under App Store review, then remove it so merchants are billed for real.
SHOPIFY_BILLING_TEST=

# Optional: protects /api/competitors/crawl. Leave empty to disable the crawler
# in production (requests return 500 until it is configured).
COMPETITOR_CRON_SECRET=

# Optional: only needed for shops using a custom Shopify domain
# SHOP_CUSTOM_DOMAIN=
